# frozen_string_literal: true

# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure('2') do |config|
  config.vm.boot_timeout = 600

  config.vm.define :as do |as|
    define_machine_spec as, '1', '1024'
    as.vm.hostname = 'as.local.cyphonic.org'
    as.vm.box = 'generic/ubuntu2004'
    as.vm.network :public_network,
                  ip: '10.0.100.201',
                  netmask: '255.255.255.0',
                  bridge: 'enp2s0',
                  dev: 'enp2s0'
  end

  config.vm.define :nms do |nms|
    define_machine_spec nms, '1', '1024'
    nms.vm.hostname = 'nms01.local.cyphonic.org'
    nms.vm.box = 'generic/ubuntu2004'
    nms.vm.network :public_network,
                   ip: '10.0.100.202',
                   netmask: '255.255.255.0',
                   bridge: 'enp2s0',
                   dev: 'enp2s0'
  end

  config.vm.define :cockroach do |cockroach|
    define_machine_spec cockroach, '1', '1024'
    cockroach.vm.hostname = 'cyphonic-cockroach'
    cockroach.vm.box = 'generic/ubuntu2004'
    cockroach.vm.network :public_network,
                         ip: '10.0.100.204',
                         netmask: '255.255.255.0',
                         bridge: 'enp2s0',
                         dev: 'enp2s0'
  end

  config.vm.define :controller do |controller|
    define_machine_spec controller, '1', '1024'
    controller.vm.hostname = 'controller.local.cyphonic.org'
    controller.vm.box = 'generic/ubuntu2004'
    controller.vm.network :public_network,
                          ip: '10.0.100.205',
                          netmask: '255.255.255.0',
                          bridge: 'enp2s0',
                          dev: 'enp2s0'
  end

  ## Define macros
  def define_machine_spec(name, use_cpu, use_memory)
    name.vm.provider :libvirt do |libvirt|
      libvirt.driver = 'qemu'
      libvirt.cpus = use_cpu
      libvirt.memory = use_memory
    end
  end
end
